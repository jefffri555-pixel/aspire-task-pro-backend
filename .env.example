# Server Configurations
PORT=5000
NODE_ENV=development

# Database Configurations (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE=aspire_task_pro
DB_PASSWORD=postgres
DB_PORT=5432

# JWT Secret
JWT_SECRET=super_secret_aspire_task_pro_key_12345!

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Service Account Path
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Lead Tracking Webhook Config
LEAD_TRACKING_WEBHOOK_URL=https://webhook.site/mock-url
TASK_SYNC_SECRET=your_secret_key_here
